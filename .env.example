# 由 make init 自动改写。必须是已经挂载且可写的 4 TB NVMe 路径。
H3_DATA_ROOT=/mnt/CHANGE_ME/minimax-h3

HOST_UID=1000
HOST_GID=1000

# 默认仅本机监听，通过 SSH 隧道访问。
COMFYUI_BIND=127.0.0.1
COMFYUI_PORT=8188

BASE_IMAGE=nvcr.io/nvidia/pytorch:26.10-py3
COMFYUI_REF=v0.45.0
# 可选国内 PyPI 镜像；依赖包仍按 requirements-lock.txt 的官方 SHA-256 校验。
PIP_INDEX_URL=https://pypi.org/simple
# 备用索引；多个地址需要用双引号包住，空格分隔。
PIP_EXTRA_INDEX_URL=

# GB10 稳定优先配置
RESERVE_VRAM_GB=12
VRAM_HEADROOM_GB=3
ASYNC_OFFLOAD_STREAMS=2
CACHE_MODE=none
CACHE_LRU=1
OMP_NUM_THREADS=12

# ModelScope 国内站：https://modelscope.cn/models/Comfy-Org/MiniMax-H3
# 公开模型通常无需认证；如需认证请填 ModelScope API Token，勿提交到 Git。
MODELSCOPE_API_TOKEN=

# 可选：附加官方 ComfyUI 参数。基线阶段保持为空。
COMFYUI_EXTRA_ARGS=
